{
  "@alexgorbatchev/pi-workspace": {
    "configs": [
      {
        "when": "~/development/tools/*",
        "load": "./fixtures/workspaces/tools/_common"
      },
      {
        "when": "~/development/tools/pi-workspace",
        "load": "./fixtures/workspaces/tools/pi-workspace"
      },
      {
        "when": "/tmp/company-b/client-portal",
        "load": "./fixtures/workspaces/company-b/portal"
      },
      {
        "when": "~/development/company-b/client-portal",
        "load": "./fixtures/workspaces/company-b/portal"
      }
    ]
  }
}
